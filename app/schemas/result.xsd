<?xml version="1.0" encoding="UTF-8"?>
<!--
  Esquema del documento de resultados de math-semantic-ocr (version 1.0).
  Espacio de nombres propio del proyecto (no es un estandar del W3C):
      urn:math-semantic-ocr:result:1
  El MathML se incrusta en su espacio de nombres oficial y NO se valida aqui
  (processContents="skip"). Limites del XSD: ver README (seccion "Que no verifica el XSD").
  Se usa solo XSD 1.0, que es lo que soporta lxml/libxml2.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:math-semantic-ocr:result:1"
           targetNamespace="urn:math-semantic-ocr:result:1"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="1.0">

  <!-- ===== tipos simples ===== -->
  <xs:simpleType name="StageName">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ocr"/>
      <xs:enumeration value="converter"/>
      <xs:enumeration value="semantic_agent"/>
      <xs:enumeration value="rules"/>
      <xs:enumeration value="enrichment"/>
      <xs:enumeration value="braille"/>
      <xs:enumeration value="speech"/>
      <xs:enumeration value="audio"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StageStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="OK"/>
      <xs:enumeration value="FAILED"/>
      <xs:enumeration value="SKIPPED"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NodeTypeName">
    <xs:restriction base="xs:string">
      <xs:enumeration value="element"/>
      <xs:enumeration value="operation"/>
      <xs:enumeration value="relation"/>
      <xs:enumeration value="structure"/>
      <xs:enumeration value="function"/>
      <xs:enumeration value="calculus"/>
      <xs:enumeration value="unresolved"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LinkTypeName">
    <xs:restriction base="xs:string">
      <xs:enumeration value="binds"/>
      <xs:enumeration value="same_entity"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OverallStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="VALIDATED"/>
      <xs:enumeration value="NOT_VALIDATED"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RuleOutcome">
    <xs:restriction base="xs:string">
      <xs:enumeration value="PASS"/>
      <xs:enumeration value="FAIL"/>
      <xs:enumeration value="REVIEW"/>
      <xs:enumeration value="NOT_APPLICABLE"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RuleOrigin">
    <xs:restriction base="xs:string">
      <xs:enumeration value="w3c_normative"/>
      <xs:enumeration value="project_heuristic"/>
      <xs:enumeration value="llm_derived"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Severity">
    <xs:restriction base="xs:string">
      <xs:enumeration value="info"/>
      <xs:enumeration value="warning"/>
      <xs:enumeration value="error"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Evidence">
    <xs:restriction base="xs:string">
      <xs:enumeration value="directly_supported"/>
      <xs:enumeration value="context_dependent"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ===== tipos complejos ===== -->
  

  <!-- ===== elemento raiz ===== -->
  <xs:element name="result">
    <xs:complexType>
      <xs:sequence>

        <xs:element name="metadata">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="createdAt" type="xs:dateTime"/>
              <xs:element name="tools">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="tool" minOccurs="0" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:attribute name="role" type="xs:string" use="required"/>
                        <xs:attribute name="name" type="xs:string" use="required"/>
                        <xs:attribute name="version" type="xs:string" use="optional"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="rulesCatalogVersion" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="input">
          <xs:complexType>
            <xs:sequence>
              <!-- Solo el nombre del archivo, nunca la ruta completa -->
              <xs:element name="imageRef" type="xs:string"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="stages">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="stage" minOccurs="1" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="name" type="t:StageName" use="required"/>
                  <xs:attribute name="status" type="t:StageStatus" use="required"/>
                  <xs:attribute name="required" type="xs:boolean" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="ocr" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="latexRaw" type="xs:string" minOccurs="0"/>
              <xs:element name="latexReviewed" type="xs:string" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="attempt" type="xs:nonNegativeInteger" use="required"/>
            <xs:attribute name="reviewedByHuman" type="xs:boolean" use="required"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="mathml" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:any namespace="http://www.w3.org/1998/Math/MathML"
                      processContents="skip" minOccurs="1" maxOccurs="1"/>
            </xs:sequence>
            <xs:attribute name="kind" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="enrichment" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="appliedIntent" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="enrichedMathml" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:any namespace="http://www.w3.org/1998/Math/MathML" processContents="skip" minOccurs="1" maxOccurs="1"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="mathCatChecked" type="xs:boolean" use="required"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="semantic" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="nodes">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="node" minOccurs="1" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="operand" minOccurs="0" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:attribute name="role" type="xs:string" use="required"/>
                              <xs:attribute name="nodeId" type="xs:string" use="required"/>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="candidateIntent" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
                          <xs:element name="property" minOccurs="0" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:attribute name="name" type="xs:string" use="required"/>
                              <xs:attribute name="value" type="xs:string" use="required"/>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="justification" type="xs:string" minOccurs="0"/>
                        </xs:sequence>
                        <xs:attribute name="id" type="xs:string" use="required"/>
                        <xs:attribute name="nodeType" type="t:NodeTypeName" use="required"/>
                        <xs:attribute name="intent" type="xs:string" use="optional"/>
                        <xs:attribute name="symbol" type="xs:string" use="optional"/>
                        <xs:attribute name="implicit" type="xs:boolean" use="required"/>
                        <xs:attribute name="evaluationOrder" type="xs:nonNegativeInteger" use="optional"/>
                        <xs:attribute name="evidence" type="t:Evidence" use="required"/>
                        <xs:attribute name="ambiguous" type="xs:boolean" use="required"/>
                        <xs:attribute name="reviewRequired" type="xs:boolean" use="required"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="links">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="link" minOccurs="0" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:attribute name="type" type="t:LinkTypeName" use="required"/>
                        <xs:attribute name="source" type="xs:string" use="required"/>
                        <xs:attribute name="target" type="xs:string" use="required"/>
                        <xs:attribute name="evidence" type="t:Evidence" use="required"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="assumptions">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="assumption" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="ambiguities">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="ambiguity" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="vocabularyVersion" type="xs:string" use="required"/>
            <xs:attribute name="rootId" type="xs:string" use="required"/>
            <xs:attribute name="reviewRequired" type="xs:boolean" use="required"/>
            <xs:attribute name="provider" type="xs:string" use="optional"/>
            <xs:attribute name="model" type="xs:string" use="optional"/>
            <xs:attribute name="inputLatexSha256" type="xs:string" use="optional"/>
            <xs:attribute name="inputMathmlSha256" type="xs:string" use="optional"/>
          </xs:complexType>

          <!-- ids de nodo unicos; operandos, enlaces y raiz que apuntan a ids existentes -->
          <xs:unique name="nodeIdUnique">
            <xs:selector xpath="t:nodes/t:node"/>
            <xs:field xpath="@id"/>
          </xs:unique>
          <xs:keyref name="operandRef" refer="t:nodeIdUnique">
            <xs:selector xpath="t:nodes/t:node/t:operand"/>
            <xs:field xpath="@nodeId"/>
          </xs:keyref>
          <xs:keyref name="linkSourceRef" refer="t:nodeIdUnique">
            <xs:selector xpath="t:links/t:link"/>
            <xs:field xpath="@source"/>
          </xs:keyref>
          <xs:keyref name="linkTargetRef" refer="t:nodeIdUnique">
            <xs:selector xpath="t:links/t:link"/>
            <xs:field xpath="@target"/>
          </xs:keyref>
          <xs:keyref name="rootRef" refer="t:nodeIdUnique">
            <xs:selector xpath="."/>
            <xs:field xpath="@rootId"/>
          </xs:keyref>
        </xs:element>

        <xs:element name="braille" minOccurs="0">
          <!-- Texto braille Unicode: NO es un archivo BRF ni salida para linea braille -->
          <xs:complexType>
            <xs:sequence>
              <xs:element name="unicode" type="xs:string" minOccurs="0"/>
              <xs:element name="unicodeReviewed" type="xs:string" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="code" type="xs:string" use="required"/>
            <xs:attribute name="mathcatCode" type="xs:string" use="optional"/>
            <xs:attribute name="language" type="xs:string" use="optional"/>
            <xs:attribute name="reviewRequired" type="xs:boolean" use="required"/>
            <xs:attribute name="reviewedByHuman" type="xs:boolean" use="required"/>
            <xs:attribute name="mathcatVersion" type="xs:string" use="optional"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="speech" minOccurs="0">
          <!-- Texto de lectura matematica generado por MathCAT: NO es audio -->
          <xs:complexType>
            <xs:sequence>
              <xs:element name="text" type="xs:string"/>
            </xs:sequence>
            <xs:attribute name="language" type="xs:string" use="required"/>
            <xs:attribute name="style" type="xs:string" use="optional"/>
            <xs:attribute name="verbosity" type="xs:string" use="optional"/>
            <xs:attribute name="reviewRequired" type="xs:boolean" use="required"/>
            <xs:attribute name="mathcatVersion" type="xs:string" use="optional"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="audio" minOccurs="0">
          <!-- Solo existe si el archivo de audio se genero y se verifico; fileRef es solo el nombre -->
          <xs:complexType>
            <xs:sequence>
              <xs:element name="fileRef" type="xs:string"/>
            </xs:sequence>
            <xs:attribute name="provider" type="xs:string" use="required"/>
            <xs:attribute name="language" type="xs:string" use="optional"/>
            <xs:attribute name="format" type="xs:string" use="required"/>
            <xs:attribute name="sizeBytes" type="xs:nonNegativeInteger" use="required"/>
            <xs:attribute name="voice" type="xs:string" use="optional"/>
            <xs:attribute name="reviewRequired" type="xs:boolean" use="required"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="rules">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="rule" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="message" type="xs:string"/>
                    <xs:element name="evidenceRef" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
                  </xs:sequence>
                  <xs:attribute name="id" type="xs:string" use="required"/>
                  <xs:attribute name="version" type="xs:string" use="required"/>
                  <xs:attribute name="origin" type="t:RuleOrigin" use="required"/>
                  <xs:attribute name="outcome" type="t:RuleOutcome" use="required"/>
                  <xs:attribute name="severity" type="t:Severity" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="validation">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="reason" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="overall" type="t:OverallStatus" use="required"/>
            <xs:attribute name="semanticReviewRequired" type="xs:boolean" use="required"/>
            <xs:attribute name="brailleGenerated" type="xs:boolean" use="required"/>
            <xs:attribute name="speechGenerated" type="xs:boolean" use="required"/>
            <xs:attribute name="audioGenerated" type="xs:boolean" use="required"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="issues">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="issue" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="stage" type="xs:string" use="required"/>
                      <xs:attribute name="code" type="xs:string" use="required"/>
                      <xs:attribute name="level" type="t:Severity" use="required"/>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

      </xs:sequence>
      <xs:attribute name="schemaVersion" type="xs:string" use="required" fixed="1.0"/>
      <xs:attribute name="runId" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>

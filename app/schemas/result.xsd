<?xml version="1.0" encoding="UTF-8"?>
<!--
  Esquema del documento de resultados de math-semantic-ocr (version 1.0).
  Espacio de nombres propio del proyecto (no es un estandar del W3C):
      urn:math-semantic-ocr:result:1
  El MathML se incrusta en su espacio de nombres oficial y NO se valida aqui
  (processContents="skip"). Limites del XSD: ver README (seccion "Que no verifica el XSD").
  Se usa solo XSD 1.0, que es lo que soporta lxml/libxml2.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:math-semantic-ocr:result:1"
           targetNamespace="urn:math-semantic-ocr:result:1"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="1.0">

  <!-- ===== tipos simples ===== -->
  <xs:simpleType name="StageName">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ocr"/>
      <xs:enumeration value="converter"/>
      <xs:enumeration value="semantic_agent"/>
      <xs:enumeration value="rules"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StageStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="OK"/>
      <xs:enumeration value="FAILED"/>
      <xs:enumeration value="SKIPPED"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OverallStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="VALIDATED"/>
      <xs:enumeration value="NOT_VALIDATED"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RuleOutcome">
    <xs:restriction base="xs:string">
      <xs:enumeration value="PASS"/>
      <xs:enumeration value="FAIL"/>
      <xs:enumeration value="REVIEW"/>
      <xs:enumeration value="NOT_APPLICABLE"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RuleOrigin">
    <xs:restriction base="xs:string">
      <xs:enumeration value="w3c_normative"/>
      <xs:enumeration value="project_heuristic"/>
      <xs:enumeration value="llm_derived"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Severity">
    <xs:restriction base="xs:string">
      <xs:enumeration value="info"/>
      <xs:enumeration value="warning"/>
      <xs:enumeration value="error"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Evidence">
    <xs:restriction base="xs:string">
      <xs:enumeration value="directly_supported"/>
      <xs:enumeration value="context_dependent"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ===== tipos complejos ===== -->
  <xs:complexType name="NodeType">
    <xs:sequence>
      <xs:element name="symbol" type="xs:string" minOccurs="0"/>
      <xs:element name="node" type="t:NodeType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="kind" type="xs:string" use="required"/>
    <xs:attribute name="evidence" type="t:Evidence" use="required"/>
    <xs:attribute name="role" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- ===== elemento raiz ===== -->
  <xs:element name="result">
    <xs:complexType>
      <xs:sequence>

        <xs:element name="metadata">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="createdAt" type="xs:dateTime"/>
              <xs:element name="tools">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="tool" minOccurs="0" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:attribute name="role" type="xs:string" use="required"/>
                        <xs:attribute name="name" type="xs:string" use="required"/>
                        <xs:attribute name="version" type="xs:string" use="optional"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="rulesCatalogVersion" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="input">
          <xs:complexType>
            <xs:sequence>
              <!-- Solo el nombre del archivo, nunca la ruta completa -->
              <xs:element name="imageRef" type="xs:string"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="stages">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="stage" minOccurs="1" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="name" type="t:StageName" use="required"/>
                  <xs:attribute name="status" type="t:StageStatus" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="ocr" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="latexRaw" type="xs:string" minOccurs="0"/>
              <xs:element name="latexReviewed" type="xs:string" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="attempt" type="xs:nonNegativeInteger" use="required"/>
            <xs:attribute name="reviewedByHuman" type="xs:boolean" use="required"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="mathml" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:any namespace="http://www.w3.org/1998/Math/MathML"
                      processContents="skip" minOccurs="1" maxOccurs="1"/>
            </xs:sequence>
            <xs:attribute name="kind" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="semantic" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="expressionType" type="xs:string"/>
              <xs:element name="root">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="node" type="t:NodeType"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="relations">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="relation" minOccurs="0" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:attribute name="type" type="xs:string" use="required"/>
                        <xs:attribute name="left" type="xs:string" use="required"/>
                        <xs:attribute name="right" type="xs:string" use="required"/>
                        <xs:attribute name="evidence" type="t:Evidence" use="required"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="assumptions">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="assumption" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="ambiguities">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="ambiguity" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="requiresReview" type="xs:boolean"/>
            </xs:sequence>
            <xs:attribute name="provider" type="xs:string" use="optional"/>
            <xs:attribute name="model" type="xs:string" use="optional"/>
          </xs:complexType>

          <!-- ids de nodo unicos y relaciones que apuntan a ids existentes -->
          <xs:unique name="nodeIdUnique">
            <xs:selector xpath=".//t:node"/>
            <xs:field xpath="@id"/>
          </xs:unique>
          <xs:keyref name="relationLeftRef" refer="t:nodeIdUnique">
            <xs:selector xpath="t:relations/t:relation"/>
            <xs:field xpath="@left"/>
          </xs:keyref>
          <xs:keyref name="relationRightRef" refer="t:nodeIdUnique">
            <xs:selector xpath="t:relations/t:relation"/>
            <xs:field xpath="@right"/>
          </xs:keyref>
        </xs:element>

        <xs:element name="rules">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="rule" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="message" type="xs:string"/>
                    <xs:element name="evidenceRef" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
                  </xs:sequence>
                  <xs:attribute name="id" type="xs:string" use="required"/>
                  <xs:attribute name="version" type="xs:string" use="required"/>
                  <xs:attribute name="origin" type="t:RuleOrigin" use="required"/>
                  <xs:attribute name="outcome" type="t:RuleOutcome" use="required"/>
                  <xs:attribute name="severity" type="t:Severity" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="validation">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="reason" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="overall" type="t:OverallStatus" use="required"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="issues">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="issue" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="stage" type="xs:string" use="required"/>
                      <xs:attribute name="code" type="xs:string" use="required"/>
                      <xs:attribute name="level" type="t:Severity" use="required"/>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

      </xs:sequence>
      <xs:attribute name="schemaVersion" type="xs:string" use="required" fixed="1.0"/>
      <xs:attribute name="runId" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>

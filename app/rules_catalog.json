  "rules": [
    {
      "id": "MML-001",
      "version": "1.0.0",
      "title": "Raiz <math> en el espacio de nombres MathML",
      "description": "El documento MathML debe estar bien formado y su elemento raiz debe ser 'math' en el espacio de nombres http://www.w3.org/1998/Math/MathML.",
      "applies_when": "Siempre que exista un MathML.",
      "expected": "PASS si es analizable y la raiz es {MathML}math; FAIL en caso contrario.",
      "severity": "error",
      "origin": "w3c_normative",
      "source": {
        "document": "MathML 3.0 (2.a edicion)",
        "url": "https://www.w3.org/TR/MathML3/",
        "status": "W3C Recommendation (2014)",
        "note": "Seccion exacta por verificar; la regla resume la definicion del elemento raiz y su espacio de nombres."
      },
      "examples": [
        {
          "name": "raiz valida",
          "mathml": "eq",
          "semantic": null,
          "expected": "PASS"
        },
        {
          "name": "sin espacio de nombres",
          "mathml": "no_ns",
          "semantic": null,
          "expected": "FAIL"
        },
        {
          "name": "xml mal formado",
          "mathml": "bad_xml",
          "semantic": null,
          "expected": "FAIL"
        }
      ]
    },
    {
      "id": "MML-002",
      "version": "1.0.0",
      "title": "Elementos dentro del conjunto de MathML Core",
      "description": "Todos los elementos deben pertenecer al conjunto de elementos de MathML Core. La pertenencia al conjunto es definicion del W3C; informarla como REVIEW (y no FAIL) es decision del proyecto, porque MathML Core es un subconjunto y MathML 3 permite mas elementos.",
      "applies_when": "Cuando el MathML es analizable.",
      "expected": "PASS si todos los elementos estan en Core; REVIEW si hay elementos fuera de Core o fuera del espacio de nombres MathML; NOT_APPLICABLE si el MathML no es analizable.",
      "severity": "warning",
      "origin": "w3c_normative",
      "source": {
        "document": "MathML Core",
        "url": "https://www.w3.org/TR/mathml-core/",
        "status": "Candidate Recommendation Snapshot (2025-06-24); no es Recommendation",
        "note": "Lista de elementos contrastada con el primer borrador publico y con extractos del CR; volver a contrastar con el CR vigente."
      },
      "examples": [
        {
          "name": "solo elementos Core",
          "mathml": "eq",
          "semantic": null,
          "expected": "PASS"
        },
        {
          "name": "mfenced no esta en Core",
          "mathml": "mfenced",
          "semantic": null,
          "expected": "REVIEW"
        },
        {
          "name": "mathml no analizable",
          "mathml": "bad_xml",
          "semantic": null,
          "expected": "NOT_APPLICABLE"
        }
      ]
    },
    {
      "id": "MML-003",
      "version": "1.0.0",
      "title": "Uso del atributo intent (borrador)",
      "description": "El atributo 'intent' se define en MathML 4, que sigue siendo Working Draft. Si aparece, se marca para revision humana y NO se evalua su gramatica ni se le atribuye valor normativo.",
      "applies_when": "Cuando el MathML es analizable.",
      "expected": "REVIEW si algun elemento lleva 'intent'; NOT_APPLICABLE si ninguno lo lleva o el MathML no es analizable.",
      "severity": "info",
      "origin": "project_heuristic",
      "source": {
        "document": "MathML 4.0",
        "url": "https://www.w3.org/TR/mathml4/",
        "status": "W3C Working Draft (27 de octubre de 2026)",
        "note": "El estado de borrador puede cambiar; la regla es del proyecto, no del W3C."
      },
      "examples": [
        {
          "name": "sin intent",
          "mathml": "eq",
          "semantic": null,
          "expected": "NOT_APPLICABLE"
        },
        {
          "name": "con intent",
          "mathml": "intent",
          "semantic": null,
          "expected": "REVIEW"
        }
      ]
    },
    {
      "id": "SEM-001",
      "version": "1.0.0",
      "title": "Interpretacion semantica disponible y valida",
      "description": "Existe un resultado semantico que supero la validacion de esquema.",
      "applies_when": "Siempre.",
      "expected": "PASS si hay interpretacion valida; REVIEW si falta (sin ella no se pueden evaluar las reglas semanticas).",
      "severity": "warning",
      "origin": "project_heuristic",
      "source": {
        "document": "Proyecto math-semantic-ocr",
        "url": "",
        "status": "heuristica propia",
        "note": ""
      },
      "examples": [
        {
          "name": "hay interpretacion",
          "mathml": "eq",
          "semantic": "eq_ok",
          "expected": "PASS"
        },
        {
          "name": "falta interpretacion",
          "mathml": "eq",
          "semantic": null,
          "expected": "REVIEW"
        }
      ]
    },
    {
      "id": "SEM-002",
      "version": "1.0.0",
      "title": "Simbolos de la interpretacion presentes en el MathML",
      "description": "Cada simbolo de nodo (hoja u operador escrito) debe aparecer como contenido de un token (mi, mn, mo, mtext, ms) del MathML. Puede dar falsos positivos con simbolos implicitos.",
      "applies_when": "Hay interpretacion valida y MathML analizable.",
      "expected": "PASS si todos aparecen; FAIL si alguno no aparece (con los ids como evidencia); NOT_APPLICABLE si faltan datos.",
      "severity": "warning",
      "origin": "project_heuristic",
      "source": {
        "document": "Proyecto math-semantic-ocr",
        "url": "",
        "status": "heuristica propia",
        "note": ""
      },
      "examples": [
        {
          "name": "simbolos presentes",
          "mathml": "eq",
          "semantic": "eq_ok",
          "expected": "PASS"
        },
        {
          "name": "simbolo inventado",
          "mathml": "eq",
          "semantic": "eq_ungrounded",
          "expected": "FAIL"
        },
        {
          "name": "sin interpretacion",
          "mathml": "eq",
          "semantic": null,
          "expected": "NOT_APPLICABLE"
        },
        {
          "name": "mathml no analizable",
          "mathml": "bad_xml",
          "semantic": "eq_ok",
          "expected": "NOT_APPLICABLE"
        }
      ]
    },
    {
      "id": "SEM-003",
      "version": "1.0.0",
      "title": "Igualdad en el MathML reflejada como intent equality",
      "description": "Si el MathML contiene el token '=', la interpretacion debe contener un nodo con intent 'equality'.",
      "applies_when": "Hay interpretacion valida y el MathML contiene un token '='.",
      "expected": "PASS si existe el nodo; REVIEW si no; NOT_APPLICABLE si no hay '=' o faltan datos.",
      "severity": "warning",
      "origin": "project_heuristic",
      "source": {
        "document": "Proyecto math-semantic-ocr",
        "url": "",
        "status": "heuristica propia",
        "note": ""
      },
      "examples": [
        {
          "name": "igualdad reflejada",
          "mathml": "eq",
          "semantic": "eq_ok",
          "expected": "PASS"
        },
        {
          "name": "igualdad ausente",
          "mathml": "eq",
          "semantic": "no_equality",
          "expected": "REVIEW"
        },
        {
          "name": "no hay igualdad en el MathML",
          "mathml": "frac",
          "semantic": "frac_ok",
          "expected": "NOT_APPLICABLE"
        }
      ]
    },
    {
      "id": "SEM-004",
      "version": "1.0.0",
      "title": "Estructuras del MathML reflejadas en intents",

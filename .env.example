# Copia este archivo a .env. No subas .env al control de versiones.
OUTPUT_DIR=outputs
LOG_LEVEL=INFO

# --- Agente semantico (LLM). Local por defecto (Ollama); remoto opcional.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
# Proveedor remoto compatible con la API de chat tipo OpenAI (puede tener coste por token):
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- MathCAT (braille y lectura matematica). Los valores por defecto viven en MathCATConfiguration.
# Carpeta "Rules" de MathCAT (obligatoria para braille/lectura). Se obtiene del repositorio de MathCAT.
MATHCAT_RULES_DIR=
# Codigo braille: nemeth | ueb_technical | cmu   (por defecto cmu)
MATHCAT_BRAILLE_CODE=cmu
# Idioma de la lectura matematica (por defecto es)
MATHCAT_SPEECH_LANGUAGE=es
# ClearSpeak | SimpleSpeak   y   Terse | Medium | Verbose
MATHCAT_SPEECH_STYLE=ClearSpeak
MATHCAT_VERBOSITY=Medium
# Solo si el modulo nativo de MathCAT no se llama libmathcat_py ni libmathcat (se admite una lista cerrada)
MATHCAT_PY_MODULE=

# Copia este archivo a .env. No subas .env al control de versiones.
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
# Proveedor LLM (se usara en la fase del agente semantico)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
# Solo si usas un proveedor remoto (nunca en el codigo):
LLM_API_KEY=
# Proveedor remoto compatible con la API de chat tipo OpenAI (opcional)
LLM_BASE_URL=
LLM_MODEL=
